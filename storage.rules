rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Media is served through the authenticated API. In particular, documents
    // in the legal domain must never be readable from a public Storage URL.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.erp_admin == true;
    }
  }
}
