# Copie para .env.firebase. Este arquivo e ignorado pelo Git.
# O backend usa Admin SDK; a configuracao JavaScript do site nao autentica o Python.
DATA_MODE=firebase
FIREBASE_PROJECT_ID=sdm-2959c
FIREBASE_STORAGE_BUCKET=sdm-2959c.firebasestorage.app
FIREBASE_WEB_API_KEY=your-public-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=sdm-2959c.firebaseapp.com
FIREBASE_WEB_APP_ID=your-web-app-id
# FIREBASE_WEB_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_WEB_MEASUREMENT_ID=your-measurement-id

# Mantenha false apenas em desenvolvimento local. Producao exige true.
APP_ENV=development
AUTH_REQUIRED=false

# Local: use Application Default Credentials ou informe um arquivo fora do Git.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\\caminho\\seguro\\service-account.json
