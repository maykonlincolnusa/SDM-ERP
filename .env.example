# Local demo (default)
DATA_MODE=demo
AUTH_REQUIRED=false

# Google Cloud / Firebase
# Para o projeto Firebase local, copie .env.firebase.example para .env.firebase.
# DATA_MODE=firebase
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# AUTH_REQUIRED=true
# In Cloud Run, grant the service account Firestore access and use ADC.
# For local Firebase use only, set this to a credential file outside version control:
# FIREBASE_SERVICE_ACCOUNT_PATH=.firebase-service-account.json

# Camadas de dados e arquivos adicionados localmente
# DATA_RAW_PATH=data/raw
# DATA_BRONZE_PATH=data/bronze
# DATA_SILVER_PATH=data/silver
# DATA_GOLD_PATH=data/gold
# DATA_RUNTIME_PATH=data/runtime
# MEDIA_INBOX_PATH=data/raw/inbox
# MEDIA_LIBRARY_PATH=data/runtime/media_library
